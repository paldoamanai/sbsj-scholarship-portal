# Copy to the project root as .env.local and fill in the values:
#   cp env/.env.example .env.local
# Next.js only reads .env files from the project root, not from this folder.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# Public URL of the site, used for links in emails and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="San Jose Scholarship <noreply@example.com>"

# --- Notifications webhook ---
# Must match <WEBHOOK_SECRET> in supabase/notification_webhook.sql.
NOTIFICATION_WEBHOOK_SECRET=

# --- Cloudflare Turnstile (optional) ---
# Leave empty to turn the captcha off on the auth forms.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
