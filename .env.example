# Base URL only — no /rest/v1/ suffix (wrong value breaks login with "invalid path specified in request url")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Email notifications (Resend) ──
# Sending is skipped silently when RESEND_API_KEY is not set.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend (onboarding@resend.dev works for testing to your own email).
EMAIL_FROM="SBSJ Scholarship <onboarding@resend.dev>"
# Public URL of the site, used for links inside emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only. Lets the webhook look up recipients' emails. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string. Must match the header configured on the Supabase database webhook.
NOTIFICATION_WEBHOOK_SECRET=
